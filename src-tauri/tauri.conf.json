{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PHIMBOP",
  "version": "0.1.0",
  "identifier": "com.phimbop.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PHIMBOP - Phim gì cũng có!",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob: data:; connect-src 'self' ipc: https: http: ws:; font-src 'self' data:;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "PHIMBOP Desktop - Phim gì cũng có",
    "longDescription": "PHIMBOP Desktop - Ứng dụng xem phim đa nền tảng cho Windows, macOS và Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMzc1OEZCRDE2NDI1MzQKUlVRZ0hBbnlQcE51LzcxR3k2UjkvL09uNmpWNGJmSUt2MDFGSmhKRHh4clZ2b2V1ZjlZcFB4czgK",
      "endpoints": [
        "https://nhxgdsanykpnmghtohfz.supabase.co/functions/v1/app-update?target={{target}}&current_version={{current_version}}"
      ]
    }
  }
}
