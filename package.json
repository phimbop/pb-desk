		"@tailwindcss/vite": "^4.0.9",
		"@tauri-apps/cli": "^2.2.7",
		"@types/bun": "^1.4.2",
		"@types/node": "^22.13.5",
		"svelte": "^5.20.2",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.9",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.7.3",
		"vite": "^6.1.1"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.116.0",
