{
	"name": "pb-desk",
	"private": true,
	"version": "0.1.3",
	"type": "module",
	"scripts": {
		"agent:run": "bun --no-env-file run scripts/agent/run.ts",
		"agent:verify": "bun --no-env-file run scripts/agent/verify.ts",
		"agent:eval": "bun test scripts/agent",
		"agent:typecheck": "tsc -p scripts/agent/tsconfig.json",
		"agent:install": "bun --no-env-file run scripts/agent/install.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"sync:versions": "bun run scripts/agent/sync_supabase_versions.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.1",
