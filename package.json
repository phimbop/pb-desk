		"@tauri-apps/plugin-updater": "^2.11.0",
		"clsx": "^2.1.1",
		"embla-carousel": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"hls.js": "^1.5.20",
		"media-icons": "^1.1.5",
		"runed": "^0.37.1",
		"schema-dts": "^2.0.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "^3.0.1",
		"vidstack": "^1.12.13"
