# Database Configuration
DB_DB=pbdb
DB_ENDPOINT=wss://srv2.phimbop.cfd/rpc
DB_NS=pb
DB_USER=root
DB_PASS=your_db_password

# Cache & In-Memory Stores
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379
KEYDB_URL=your_keydb_host
KEYDB_PORT=6379
KEYDB_PASSWORD=your_keydb_password

# TMDB API
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# Supabase
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=https://v3.phimbop.cfd

# Cron & Application
CRON_SECRET=your_cron_secret
ORIGIN=https://v3.phimbop.cfd
PUBLIC_WEBSITE_URL=https://v3.phimbop.cfd

# Cloudflare
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
